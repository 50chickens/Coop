<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Coop components">
    <PackageVersion Include="Coop.Library.Common" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Execution" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Hashing" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Locking" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Packages" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Artefacts" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Records" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Library.Template" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Surface" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Agent" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Plan" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Gate" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Watch" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.Pipeline" Version="$(CoopVersion)" />
    <PackageVersion Include="Coop.Services.IssueWorkflow" Version="$(CoopVersion)" />
  </ItemGroup>

  <ItemGroup Label="Agent framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Mcp" Version="1.26.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup Label="Compilation and packages">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="NuGet.Frameworks" Version="7.9.0" />
    <PackageVersion Include="NuGet.Packaging" Version="7.9.0" />
    <PackageVersion Include="NuGet.Protocol" Version="7.9.0" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Label="Hosting and surface">
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>

</Project>
